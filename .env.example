# Proveedor: "mock" (sin coste, clips de prueba) o "replicate" (IA real, requiere token y créditos)
VIDEO_PROVIDER=mock

# --- Replicate (solo si VIDEO_PROVIDER=replicate) ---
# Token en https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Modelo de vídeo de Replicate (owner/name). Comprueba su página para ver precio y parámetros.
REPLICATE_MODEL=minimax/video-01
# Duración real (s) de cada clip que genera ese modelo
CLIP_SECONDS=6
# Parámetros extra del modelo en JSON, p. ej. {"prompt_optimizer":true}
REPLICATE_EXTRA_INPUT=

# Límite de seguridad de duración total (segundos)
MAX_TOTAL_SECONDS=180
PORT=3000
